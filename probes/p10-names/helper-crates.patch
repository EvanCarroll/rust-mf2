diff --git a/crates/leptos-mf2/src/ratatui_probe.rs b/crates/leptos-mf2/src/ratatui_probe.rs
new file mode 100644
index 0000000..1d6c57e
--- /dev/null
+++ b/crates/leptos-mf2/src/ratatui_probe.rs
@@ -0,0 +1,136 @@
+//! Phase 10 A7, item 4 — a **probe**, not C5: every impl 2.0 intends between
+//! the call-site types and Ratatui, on the real types, compiled beside the
+//! Leptos glue (`--features ssr,ratatui`, `hydrate,ratatui`) and without it
+//! (`ratatui` alone), so that coherence is checked against both.
+//!
+//! The bodies are placeholders: the text comes from the Leptos layer when
+//! one is on (`to_string()`), and is empty otherwise — 2.0's ambient lookup
+//! (C2) is not built yet. What is under test is that the impls **exist
+//! together**; `probes/p10-names/coherence` checks what an application then
+//! writes, and the `probe-*` features are the rules' negative controls.
+
+use alloc::string::String;
+use core::fmt;
+
+use ratatui_core::buffer::Buffer;
+use ratatui_core::layout::Rect;
+use ratatui_core::style::{Style, Styled};
+use ratatui_core::text::{Line, Span, Text};
+use ratatui_core::widgets::Widget;
+
+use crate::{Tr, TrArgs, TrDyn, TrRich};
+
+/// The description's text, for the placeholder bodies.
+trait ProbeText {
+    fn probe_text(&self) -> String;
+}
+
+macro_rules! ratatui_probe {
+    ($ty:ty) => {
+        impl ProbeText for $ty {
+            #[cfg(feature = "leptos")]
+            fn probe_text(&self) -> String {
+                self.to_string()
+            }
+            #[cfg(not(feature = "leptos"))]
+            fn probe_text(&self) -> String {
+                String::new()
+            }
+        }
+
+        /// A span of the message's text.
+        impl From<$ty> for Span<'static> {
+            fn from(description: $ty) -> Span<'static> {
+                Span::raw(description.probe_text())
+            }
+        }
+
+        /// A line: one span per styled stretch in C5; one span here.
+        impl From<$ty> for Line<'static> {
+            fn from(description: $ty) -> Line<'static> {
+                Line::from(Span::from(description))
+            }
+        }
+
+        /// A text: split at line breaks in C5; one line here.
+        impl From<$ty> for Text<'static> {
+            fn from(description: $ty) -> Text<'static> {
+                Text::from(Line::from(description))
+            }
+        }
+
+        /// Drawn as its line.
+        impl Widget for $ty {
+            fn render(self, area: Rect, buf: &mut Buffer) {
+                Line::from(self).render(area, buf);
+            }
+        }
+
+        /// `Stylize` through `Styled`: `tr!("quit").bold()` is a `Line` that
+        /// keeps the message's own markup styles and adds the call's.
+        impl Styled for $ty {
+            type Item = Line<'static>;
+
+            fn style(&self) -> Style {
+                Style::new()
+            }
+
+            fn set_style<S: Into<Style>>(self, style: S) -> Line<'static> {
+                Line::from(self).style(style)
+            }
+        }
+
+        /// `{}` prints the message (A5 measures what this costs the web).
+        impl fmt::Display for $ty {
+            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                f.write_str(&self.probe_text())
+            }
+        }
+    };
+}
+
+ratatui_probe!(Tr);
+ratatui_probe!(TrArgs);
+ratatui_probe!(TrRich);
+ratatui_probe!(TrDyn);
+
+// ---------------------------------------------------- negative controls ---
+
+/// Rule 1's control: `From<Tr> for Cow<str>` makes `Tr: Into<Cow<str>>`,
+/// and Ratatui's `impl<'a, T: Into<Cow<'a, str>>> From<T> for Span<'a>`
+/// then overlaps the `From<Tr> for Span` above. Expected: E0119.
+#[cfg(feature = "probe-cow")]
+impl From<Tr> for alloc::borrow::Cow<'static, str> {
+    fn from(description: Tr) -> alloc::borrow::Cow<'static, str> {
+        alloc::borrow::Cow::Owned(description.probe_text())
+    }
+}
+
+/// Rule 2's control: `Line` already collects any `T: Into<Span>`
+/// (`impl<'a, T: Into<Span<'a>>> FromIterator<T> for Line<'a>`), `Tr`
+/// included. Expected: E0119.
+#[cfg(feature = "probe-fromiter")]
+impl FromIterator<Tr> for Line<'static> {
+    fn from_iter<I: IntoIterator<Item = Tr>>(iter: I) -> Line<'static> {
+        Line::from(iter.into_iter().map(Span::from).collect::<alloc::vec::Vec<_>>())
+    }
+}
+
+/// Rule 3's control: `Cell` already converts from any `T: Into<Text>`
+/// (`impl<'a, T: Into<Text<'a>>> From<T> for Cell<'a>`). Expected: E0119.
+#[cfg(feature = "probe-cell")]
+impl From<Tr> for ratatui_widgets::table::Cell<'static> {
+    fn from(description: Tr) -> ratatui_widgets::table::Cell<'static> {
+        ratatui_widgets::table::Cell::new(Text::from(description))
+    }
+}
+
+/// Rule 3's control, for lists: `ListItem::new` already takes any
+/// `T: Into<Text>`, and `From<T> for ListItem` for the same `T`.
+/// Expected: E0119.
+#[cfg(feature = "probe-listitem")]
+impl From<Tr> for ratatui_widgets::list::ListItem<'static> {
+    fn from(description: Tr) -> ratatui_widgets::list::ListItem<'static> {
+        ratatui_widgets::list::ListItem::new(Text::from(description))
+    }
+}
