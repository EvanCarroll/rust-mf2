-//! A description's text as a `String`, and `Display` — in every build
-//! (probe A5 of `plans/18-phase-10-work-order.md`).
-//!
-//! Two ways to the same text, the text the page or the request reads,
-//! isolated (the spec's Default Bidi Strategy, 04 §9):
-//!
-//! * the inherent `to_string()`, `to_plain_string()` and `String::from` —
-//!   **fmt-free**, and what the client calls. B12 keeps `core::fmt` off the
-//!   client path (`plans/06-size-and-perf.md`), and an inherent method wins
-//!   name resolution over `ToString::to_string`, so `tr.to_string()` never
-//!   reaches `Display`;
-//! * `Display` — `format!`, `println!`, `write!`, and anything generic over
-//!   `Display` — for std code: a server, a native application, a test. It is
-//!   compiled everywhere and reached only by a `{}` somewhere, so a client
-//!   that never writes one links none of it (what B12 checks).
-//!
-//! Without a Leptos mode there is no ambient catalog yet — the native store
-//! is Phase 10's C2 — so both write nothing, as the web does with no catalog
-//! (`plans/04-leptos-integration.md` §5): empty text, never a panic.
-
-use alloc::string::String;
-use core::fmt;
-
-use crate::{Tr, TrArgs, TrDyn, TrRich};
-
-macro_rules! string_conversions {
-    ($ty:ty) => {
-        impl $ty {
-            /// The message's text against the catalog in force, **isolated**:
-            /// the spec's Default Bidi Strategy, which `formatting.md` makes
-            /// the default for a message formatted as a single string (§9,
-            /// revised in Phase 7 A12). [`to_plain_string`](Self::to_plain_string)
-            /// is the form for text a program consumes.
-            ///
-            /// The same text as `Display`, without `core::fmt`: this is the
-            /// form a browser build calls.
-            #[must_use]
-            #[allow(
-                clippy::inherent_to_string_shadow_display,
-                reason = "the client's fmt-free form of what `Display` writes (B12, 06 §3); \
-                          both produce the same text"
-            )]
-            pub fn to_string(&self) -> String {
-                ambient::string(self, false)
-            }
-
-            /// The same text with no bidi isolation, for a `String` a
-            /// program consumes — a server function, a comparison, the
-            /// clipboard, `format!` — where U+2066–U+2069 would be invisible
-            /// junk.
-            #[must_use]
-            pub fn to_plain_string(&self) -> String {
-                ambient::string(self, true)
-            }
-
-            /// A synonym of [`to_string`](Self::to_string), kept from when
-            /// `to_string()` was plain.
-            #[must_use]
-            pub fn to_display_string(&self) -> String {
-                ambient::string(self, false)
-            }
-        }
-
-        impl From<$ty> for String {
-            fn from(description: $ty) -> String {
-                ambient::string(&description, false)
-            }
-        }
-
-        /// The text [`to_string`](Self::to_string) returns, written into the
-        /// formatter — padded, when the format asks (`{:<12}`).
-        impl fmt::Display for $ty {
-            fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
-                ambient::fmt(self, f)
-            }
-        }
-    };
-}
