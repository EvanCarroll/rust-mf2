From aca96c4b7b8b07ec8a83bc7f772be5044aa7998e Mon Sep 17 00:00:00 2001
From: Evan Carroll <me@evancarroll.com>
Date: Mon, 28 Sep 2026 06:26:46 -0500
Subject: [PATCH] probe(p10 A4): the hidden parts seam,
 PartSink::part_catalog_text (S)

The evaluator hands catalog text to a part sink only through this
method; its default is the old behaviour. A native sink over a
&'static Catalog overrides it to keep the text as &'static str. On the
probe branch only: measured against B1 and B12 beside R2, the range
check that needs no runtime change.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 crates/mf2-runtime/src/format.rs | 10 +---------
 crates/mf2-runtime/src/parts.rs  | 20 ++++++++++++++++++++
 2 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/crates/mf2-runtime/src/format.rs b/crates/mf2-runtime/src/format.rs
index 21b993e..e627d0f 100644
--- a/crates/mf2-runtime/src/format.rs
+++ b/crates/mf2-runtime/src/format.rs
@@ -263,15 +263,7 @@ struct PartsOut<'s> {
 
 impl Out for PartsOut<'_> {
     fn text(&mut self, catalog: &Catalog, r: StrRef) -> bool {
-        match catalog.text(r) {
-            Some(s) => {
-                if !s.is_empty() {
-                    self.out.part(Part::Text(s));
-                }
-                true
-            }
-            None => false,
-        }
+        self.out.part_catalog_text(catalog, r)
     }
 
     fn expression(&mut self, part: ExpressionPart<'_>, iso: Option<Isolation>) {
diff --git a/crates/mf2-runtime/src/parts.rs b/crates/mf2-runtime/src/parts.rs
index 9637200..f0cb48e 100644
--- a/crates/mf2-runtime/src/parts.rs
+++ b/crates/mf2-runtime/src/parts.rs
@@ -1,6 +1,7 @@
 //! Format to parts (`plans/03-runtime.md` §2.2): the shape the suite's
 //! `expParts` asserts, and what the Leptos layer builds elements from.
 
+use mf2_catalog::{Catalog, StrRef};
 use mf2_model::{Dir, MarkupKind};
 
 use crate::function::{FnContext, Function, OptionEntries};
@@ -13,6 +14,25 @@ use crate::value::Value;
 pub trait PartSink {
     /// One part.
     fn part(&mut self, part: Part<'_>);
+
+    /// The catalog string `r`, as a [`Part::Text`] — the seam for a sink
+    /// that keeps catalog text beyond the format (a native application's
+    /// `&'static` catalogs; `plans/18-phase-10-work-order.md` A4, a probe):
+    /// the evaluator hands catalog text to a part sink only through this
+    /// method. Returns `false` (and hands over nothing) when the string is
+    /// not valid (F4).
+    #[doc(hidden)]
+    fn part_catalog_text(&mut self, catalog: &Catalog, r: StrRef) -> bool {
+        match catalog.text(r) {
+            Some(s) => {
+                if !s.is_empty() {
+                    self.part(Part::Text(s));
+                }
+                true
+            }
+            None => false,
+        }
+    }
 }
 
 /// A part of a formatted message. Concatenated, the parts are the string
-- 
