# A trippy-shaped terminal UI (a live network trace): 112 messages.
# 63 plain, 24 with arguments, 10 plurals, 15 with markup.
@locale en
---

[app]
title = Network trace
subtitle = Live route analysis

[tab]
hops = Hops
chart = Chart
map = Map
flows = Flows
settings = Settings
help = Help

[col]
hop = #
host = Host
loss = Loss%
sent = Sent
recv = Recv
last = Last
avg = Avg
best = Best
worst = Wrst
stddev = StDev
status = Sts
jitter = Jttr
javg = Javg
jmax = Jmax
jint = Jint
asn = ASN
country = Country
dest = Destination
port = Port
proto = Protocol
target = Target
flow = Flow

[label]
target = Target
protocol = Protocol
family = Address family
privileged = Privileged
unprivileged = Unprivileged
status = Status
running = Running
paused = Paused
frozen = Frozen
completed = Completed
awaiting = Awaiting reply
no-response = No response
unknown = Unknown
ipv4 = IPv4
ipv6 = IPv6
icmp = ICMP
udp = UDP
tcp = TCP

[settings]
title = Settings
tui = Interface
trace = Trace
dns = DNS
geoip = GeoIP
bindings = Key bindings
theme = Theme
columns = Columns

[help]
title = Help
body = Press a key to act.\nThe arrows move between hops.\nEsc closes a panel.

[lang]
en = English
fr = Français
de = Deutsch
menu = Language
quit = Quit

[status]
target = Tracing {$host}
round = Round {$n :integer}
elapsed = Elapsed: {$secs :number} s
rate = {$rate :number maximumFractionDigits=1} probes/s
bytes = {$n :number} bytes
ttl = TTL {$ttl :integer}
port = Port {$port :integer}
src = Source: {$addr}
dest = Destination: {$addr}
iface = Interface: {$iface}
user = Running as {$user}

probes =
  .input {$n :number}
  .match $n
  one {{{$n} probe sent}}
  *   {{{$n} probes sent}}
hosts =
  .input {$n :integer}
  .match $n
  one {{{$n} host}}
  *   {{{$n} hosts}}
flows =
  .input {$n :integer}
  .match $n
  0   {{No flows}}
  one {{{$n} flow}}
  *   {{{$n} flows}}
rounds =
  .input {$n :integer}
  .match $n
  one {{{$n} round}}
  *   {{{$n} rounds}}
errors =
  .input {$n :integer}
  .match $n
  0   {{No errors}}
  one {{{$n} error}}
  *   {{{$n} errors}}
hops =
  .input {$n :integer}
  .match $n
  one {{{$n} hop}}
  *   {{{$n} hops}}
timeouts =
  .input {$n :integer}
  .match $n
  one {{{$n} timeout}}
  *   {{{$n} timeouts}}
replies =
  .input {$n :integer}
  .match $n
  one {{{$n} reply}}
  *   {{{$n} replies}}
ago =
  .input {$n :integer}
  .match $n
  one {{{$n} second ago}}
  *   {{{$n} seconds ago}}
addrs =
  .input {$n :integer}
  .match $n
  one {{{$n} address}}
  *   {{{$n} addresses}}

connected = {#ok}Connected{/ok} to {#host}{$host}{/host}
line = {#ok}{$state}{/ok} · {#host}{$host}{/host} · {$n :number} sent
warn = {#warn}Warning:{/warn} {$msg}
error = {#err}Error:{/err} {$msg}

[host]
addr = {$host} ({$addr})
asn = AS{$asn :integer} {$name}
geo = {$city}, {$country}

[row]
loss = {$pct :number maximumFractionDigits=1}%
ms = {$ms :number minimumFractionDigits=1 maximumFractionDigits=1} ms

[err]
resolve = Could not resolve {$host}
permission = Permission denied: {$detail}
socket = Socket error: {$detail}

[info]
saved = Saved to {$path}
copied = Copied {$what}
version = Version {$version}
locale = Language: {$name}

[chart]
axis = {$ms :integer} ms

[hint]
help = {#key}h{/key}elp
quit = {#key}q{/key}uit
freeze = {#key}f{/key}reeze
chart = {#key}c{/key}hart
map = {#key}m{/key}ap
settings = {#key}s{/key}ettings
language = {#key}l{/key}anguage
bar = {#key}↑↓{/key} select · {#key}Enter{/key} details · {#key}Esc{/key} back
keys = Press {#key}?{/key} for help or {#key}q{/key} to quit.

[title]
trace = {#b}Trace{/b} {#dim}{$host}{/dim}

[flow]
item = {#key}{$n :integer}{/key} {$path}
