@locale fr
---

[app]
title = Trace réseau
subtitle = Analyse de route en direct

[tab]
hops = Sauts
chart = Graphique
map = Carte
flows = Flux
settings = Réglages
help = Aide

[col]
hop = #
host = Hôte
loss = Perte%
sent = Env.
recv = Reçus
last = Dern.
avg = Moy.
best = Min.
worst = Max.
stddev = ÉcTyp
status = État
jitter = Gigue
javg = GMoy
jmax = GMax
jint = GInt
asn = ASN
country = Pays
dest = Destination
port = Port
proto = Protocole
target = Cible
flow = Flux

[label]
target = Cible
protocol = Protocole
family = Famille d'adresses
privileged = Privilégié
unprivileged = Non privilégié
status = État
running = En cours
paused = En pause
frozen = Figé
completed = Terminé
awaiting = En attente de réponse
no-response = Pas de réponse
unknown = Inconnu
ipv4 = IPv4
ipv6 = IPv6
icmp = ICMP
udp = UDP
tcp = TCP

[settings]
title = Réglages
tui = Interface
trace = Trace
dns = DNS
geoip = GéoIP
bindings = Raccourcis
theme = Thème
columns = Colonnes

[help]
title = Aide
body = Appuyez sur une touche pour agir.\nLes flèches passent d'un saut à l'autre.\nÉchap ferme un panneau.

[lang]
en = English
fr = Français
de = Deutsch
menu = Langue
quit = Quitter

[status]
target = Trace vers {$host}
round = Tour {$n :integer}
elapsed = Écoulé : {$secs :number} s
rate = {$rate :number maximumFractionDigits=1} sondes/s
bytes = {$n :number} octets
ttl = TTL {$ttl :integer}
port = Port {$port :integer}
src = Source : {$addr}
dest = Destination : {$addr}
iface = Interface : {$iface}
user = Exécuté en tant que {$user}

probes =
  .input {$n :number}
  .match $n
  one {{{$n} sonde envoyée}}
  many {{{$n} sondes envoyées}}
  *   {{{$n} sondes envoyées}}
hosts =
  .input {$n :integer}
  .match $n
  one {{{$n} hôte}}
  many {{{$n} hôtes}}
  *   {{{$n} hôtes}}
flows =
  .input {$n :integer}
  .match $n
  0   {{Aucun flux}}
  one {{{$n} flux}}
  many {{{$n} flux}}
  *   {{{$n} flux}}
rounds =
  .input {$n :integer}
  .match $n
  one {{{$n} tour}}
  many {{{$n} tours}}
  *   {{{$n} tours}}
errors =
  .input {$n :integer}
  .match $n
  0   {{Aucune erreur}}
  one {{{$n} erreur}}
  many {{{$n} erreurs}}
  *   {{{$n} erreurs}}
hops =
  .input {$n :integer}
  .match $n
  one {{{$n} saut}}
  many {{{$n} sauts}}
  *   {{{$n} sauts}}
timeouts =
  .input {$n :integer}
  .match $n
  one {{{$n} délai dépassé}}
  many {{{$n} délais dépassés}}
  *   {{{$n} délais dépassés}}
replies =
  .input {$n :integer}
  .match $n
  one {{{$n} réponse}}
  many {{{$n} réponses}}
  *   {{{$n} réponses}}
ago =
  .input {$n :integer}
  .match $n
  one {{il y a {$n} seconde}}
  many {{il y a {$n} secondes}}
  *   {{il y a {$n} secondes}}
addrs =
  .input {$n :integer}
  .match $n
  one {{{$n} adresse}}
  many {{{$n} adresses}}
  *   {{{$n} adresses}}

connected = {#ok}Connecté{/ok} à {#host}{$host}{/host}
line = {#ok}{$state}{/ok} · {#host}{$host}{/host} · {$n :number} envoyées
warn = {#warn}Attention :{/warn} {$msg}
error = {#err}Erreur :{/err} {$msg}

[host]
addr = {$host} ({$addr})
asn = AS{$asn :integer} {$name}
geo = {$city}, {$country}

[row]
loss = {$pct :number maximumFractionDigits=1} %
ms = {$ms :number minimumFractionDigits=1 maximumFractionDigits=1} ms

[err]
resolve = Impossible de résoudre {$host}
permission = Permission refusée : {$detail}
socket = Erreur de socket : {$detail}

[info]
saved = Enregistré dans {$path}
copied = {$what} copié
version = Version {$version}
locale = Langue : {$name}

[chart]
axis = {$ms :integer} ms

[hint]
help = {#key}a{/key}ide
quit = {#key}q{/key}uitter
freeze = {#key}f{/key}iger
chart = {#key}g{/key}raphique
map = {#key}c{/key}arte
settings = {#key}r{/key}églages
language = {#key}l{/key}angue
bar = {#key}↑↓{/key} choisir · {#key}Entrée{/key} détails · {#key}Échap{/key} retour
keys = Appuyez sur {#key}?{/key} pour l'aide ou sur {#key}q{/key} pour quitter.

[title]
trace = {#b}Trace{/b} {#dim}{$host}{/dim}

[flow]
item = {#key}{$n :integer}{/key} {$path}
