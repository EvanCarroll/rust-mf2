+/// `n` in decimal on at least `width` digits, zero-padded: the digits into a
+/// buffer, then the buffer through one `write_str`.
+pub(crate) fn fixed(f: &mut Formatter<'_>, mut n: u64, width: u32) -> Result {
+    let mut buf = [b'0'; 20];
+    let mut i = buf.len();
+    while i > 0 && (n > 0 || buf.len() - i < width as usize) {
+        i -= 1;
+        if let Some(slot) = buf.get_mut(i) {
+            *slot = b'0' + (n % 10) as u8;
+        }
+        n /= 10;
     }
-    f.write_char(digit(n % 10))
+    f.write_str(core::str::from_utf8(buf.get(i..).unwrap_or_default()).unwrap_or_default())
 }
 
