+/// `TrDyn { id: MsgId(n), args: [("name", value), ..] }`.
+impl core::fmt::Debug for TrDyn {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str("TrDyn { id: ")?;
+        crate::debug::msg_id(f, self.id)?;
+        f.write_str(", args: [")?;
