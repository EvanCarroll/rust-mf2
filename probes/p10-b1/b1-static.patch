+    ManifestMismatch,
+    /// The bytes are not a catalog this reader accepts.
+    #[error("mf2: {0}")]
+    Malformed(#[from] mf2_catalog::CatalogError),
+    /// No locale of that tag was built into this application.
+    #[error("mf2: no such locale")]
