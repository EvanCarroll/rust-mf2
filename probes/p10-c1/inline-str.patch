+/// A copy of the text: in place when it is short (C1's inline variant).
+impl IntoArg for &str {
+    #[inline]
+    fn into_arg(self) -> ArgValue {
+        ArgValue::Str(Text::copied(self))
+    }
+}
+
+/// As `&str`.
+impl IntoArg for char {
+    #[inline]
+    fn into_arg(self) -> ArgValue {
+        let mut buf = [0u8; 4];
+        ArgValue::Str(Text::copied(self.encode_utf8(&mut buf)))
+    }
+}
