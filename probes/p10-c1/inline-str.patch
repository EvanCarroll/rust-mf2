+
+    /// A copy of `s`: in place when it is short, else shared.
+    pub(crate) fn copied(s: &str) -> Text {
+        let mut bytes = [0u8; INLINE_TEXT];
+        match u8::try_from(s.len()) {
+            Ok(len) if s.len() <= INLINE_TEXT => {
+                for (to, from) in bytes.iter_mut().zip(s.as_bytes()) {
+                    *to = *from;
+                }
+                Text::Inline(len, bytes)
+            }
+            _ => Text::Shared(Arc::from(s)),
         }
     }
