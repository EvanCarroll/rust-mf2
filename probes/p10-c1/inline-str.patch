+/// The longest text held in place: what fits beside the tag and the length
+/// in the room the two pointer variants take (22 bytes on 64-bit targets, 10
+/// on 32-bit ones, `wasm32` among them).
+const INLINE_TEXT: usize = 3 * core::mem::size_of::<usize>() - 2;
+
 /// The text itself, quoted: whether it is shared is not what a reader of
