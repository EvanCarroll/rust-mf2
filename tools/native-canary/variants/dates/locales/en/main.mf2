# The base corpus and a date: the date formatter rows' corpus, since a
# `:datetime` message is refused by a build without the feature that serves it.
@locale en
---

plain = Save

items =
  .input {$count :integer}
  .match $count
  one {{{$count} item}}
  *   {{{$count} items}}


published = Published {$when :datetime dateLength=long timeZone=|America/New_York|}
