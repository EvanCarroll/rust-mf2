@locale ar
---

app-title = صفحة بلا خادم
tagline = تُبنى هذه الصفحة في متصفحك، باللغة التي اخترتها آخر مرة.

search-label = بحث
search-placeholder = ابحث في كل شيء

hotkey = اضغط {#kbd}Esc{/kbd} لإغلاق مربع الحوار

people-online =
  .input {$count :integer}
  .match $count
  zero {{لا أحد هنا}}
  one {{شخص واحد هنا}}
  two {{شخصان هنا}}
  few {{{$count} أشخاص هنا}}
  many {{{$count} شخصا هنا}}
  *    {{{$count} شخص هنا}}

add-one = أضف واحدا
reset = إعادة تعيين

note-label = ملاحظة:
# `untranslated` is missing here on purpose (see `en`): the catalog borrows
# it from English, which is what `mark-fallback-lang` marks. `mf2 check`
# reports it as `missing-translation`, a warning.

[language]
label = اللغة
# The switcher's button: a choice applies only when it is pressed.
apply = تطبيق
en = English
fr = Français
ar = العربية
