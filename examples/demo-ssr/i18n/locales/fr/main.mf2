@locale fr
---

app-title = MessageFormat 2 pour Leptos
tagline = Une macro. Toutes les positions. Aucune donnée de langue dans le wasm.

search-placeholder = Rechercher partout
search-label = Rechercher

greeting = Bonjour {$name} !
message-label = Message

people-online =
  .input {$count :integer}
  .match $count
  one  {{{$count} personne est ici}}
  many {{{$count} personnes sont ici}}
  *    {{{$count} personnes sont ici}}

# The element lands in a different place than in English, which is the whole
# point of markup.
hotkey = Pour fermer la boîte de dialogue, appuyez sur {#kbd}Échap{/kbd}

published = Publié le {$when :datetime dateStyle=long timeStyle=short}

add-one = Ajouter un
reset = Réinitialiser
typed-nothing = Vous n'avez encore rien saisi
typed = Vous avez saisi {$typed}
echo-label = Saisissez quelque chose

not-found = Cette page n'existe pas.

note-label = Remarque :
untranslated = Cette phrase n'a pas encore été traduite dans toutes les langues.

[nav]
label = Pages
home = Accueil
lazy = Une route différée

[lazy]
page-title = Une route différée · MessageFormat 2 pour Leptos
heading = Une route dans son propre fragment
title = Son code est arrivé quand vous l'avez ouverte
body = Le code de cette page est un {#strong}fichier wasm à part{/strong}, téléchargé en chemin.
locale-label = Rendu en

[language]
label = Langue
# The switcher's button: a choice applies only when it is pressed.
apply = Appliquer
en = English
fr = Français
ar = العربية
